generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String
  avatar        String?
  role          String    @default("USER")
  subscription  String    @default("FREE")
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  playlists     Playlist[]
  likedTracks   LikedTrack[]
  likedAlbums   LikedAlbum[]
  following     Follow[]
  streams       Stream[]
  searchHistory SearchHistory[]
  queue         QueueItem[]
}

// Role: USER, ARTIST, ADMIN, SUPER_ADMIN
// SubscriptionPlan: FREE, INDIVIDUAL, STUDENT, DUO, FAMILY, HIFI

// ==================== ARTISTS ====================

model Artist {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  bio             String?
  avatar          String?
  coverImage      String?
  verified        Boolean  @default(false)
  monthlyListeners Int     @default(0)
  totalStreams    BigInt   @default(0)
  country         String?
  genres          String?  // JSON array stored as string
  socialLinks     String?  // JSON stored as string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  albums          Album[]
  tracks          Track[]
  followers       Follow[]
  label           Label?   @relation(fields: [labelId], references: [id])
  labelId         String?
}

// ==================== LABELS ====================

model Label {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  website     String?
  country     String?
  founded     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artists     Artist[]
  albums      Album[]
}

// ==================== ALBUMS ====================

model Album {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  artwork     String?
  releaseDate DateTime?
  type        String    @default("ALBUM")
  genre       String?
  description String?
  totalTracks Int       @default(0)
  duration    Int       @default(0)
  isExplicit  Boolean   @default(false)
  isPublished Boolean   @default(false)
  upc         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  artist      Artist    @relation(fields: [artistId], references: [id])
  artistId    String
  label       Label?    @relation(fields: [labelId], references: [id])
  labelId     String?
  tracks      Track[]
  likedBy     LikedAlbum[]
}

// AlbumType: ALBUM, SINGLE, EP, COMPILATION

// ==================== TRACKS ====================

model Track {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  duration      Int      // in seconds
  trackNumber   Int      @default(1)
  discNumber    Int      @default(1)
  isExplicit    Boolean  @default(false)
  isPublished   Boolean  @default(false)
  releaseDate   DateTime?
  
  // Audio files (multiple qualities)
  audioUrl128   String?  // 128kbps OGG (free tier)
  audioUrl320   String?  // 320kbps AAC (premium)
  audioUrlFlac  String?  // FLAC lossless (hifi)
  audioOriginal String?  // Original uploaded file
  
  // Video
  videoUrl      String?  // Music video HLS URL
  canvasUrl     String?  // Short looping video
  
  // Metadata
  genre         String?
  mood          String?
  bpm           Int?
  key           String?
  isrc          String?
  lyrics        String?
  lyricsSync    String?  // JSON synced lyrics [{time, text}]
  waveformData  String?  // JSON waveform visualization data
  
  // Stats
  playCount     BigInt   @default(0)
  likeCount     Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  artist        Artist   @relation(fields: [artistId], references: [id])
  artistId      String
  album         Album?   @relation(fields: [albumId], references: [id])
  albumId       String?
  
  playlists     PlaylistTrack[]
  likedBy       LikedTrack[]
  streams       Stream[]
  queueItems    QueueItem[]
}

// ==================== PLAYLISTS ====================

model Playlist {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  artwork       String?
  isPublic      Boolean  @default(true)
  isEditorial   Boolean  @default(false)  // Created by platform
  collaborative Boolean  @default(false)
  trackCount    Int      @default(0)
  totalDuration Int      @default(0)
  mood          String?
  genre         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  userId        String
  tracks        PlaylistTrack[]
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  position   Int
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  track      Track    @relation(fields: [trackId], references: [id])
  trackId    String

  @@unique([playlistId, trackId])
}

// ==================== INTERACTIONS ====================

model LikedTrack {
  id      String   @id @default(cuid())
  likedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  track   Track    @relation(fields: [trackId], references: [id])
  trackId String

  @@unique([userId, trackId])
}

model LikedAlbum {
  id      String   @id @default(cuid())
  likedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  album   Album    @relation(fields: [albumId], references: [id])
  albumId String

  @@unique([userId, albumId])
}

model Follow {
  id         String   @id @default(cuid())
  followedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  artist     Artist   @relation(fields: [artistId], references: [id])
  artistId   String

  @@unique([userId, artistId])
}

// ==================== STREAMING & ANALYTICS ====================

model Stream {
  id             String   @id @default(cuid())
  startedAt      DateTime @default(now())
  durationPlayed Int      // seconds listened
  completed      Boolean  @default(false)
  device         String?
  country        String?
  quality        String?  // 128, 320, flac

  user           User     @relation(fields: [userId], references: [id])
  userId         String
  track          Track    @relation(fields: [trackId], references: [id])
  trackId        String
}

// ==================== QUEUE ====================

model QueueItem {
  id       String @id @default(cuid())
  position Int

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  track    Track  @relation(fields: [trackId], references: [id])
  trackId  String
}

// ==================== SEARCH ====================

model SearchHistory {
  id        String   @id @default(cuid())
  query     String
  type      String?  // track, artist, album, playlist
  searchedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// ==================== BANNERS & HOMEPAGE ====================

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  linkType    String?  // album, artist, playlist, external
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== GENRES & MOODS ====================

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  color     String?
  imageUrl  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Mood {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  color     String?
  imageUrl  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}
